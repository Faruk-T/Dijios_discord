# Local development placeholders for dijiOS Connect.
# Copy this file to .env. Do not put production secrets here.
# .env is gitignored.

# PostgreSQL 17
POSTGRES_USER=dijios
POSTGRES_PASSWORD=dijios_dev_password
POSTGRES_DB=dijios_connect
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dijios:dijios_dev_password@localhost:5432/dijios_connect

# Redis 7 (AOF enabled in compose)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# LiveKit SFU. The key and secret must match infra/docker/livekit.yaml.
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dijios-connect-local-dev-secret-key

# MinIO S3-compatible storage
MINIO_ROOT_USER=dijios_minio
MINIO_ROOT_PASSWORD=dijios_minio_dev_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=dijios-connect
MINIO_ENDPOINT=http://localhost:9000
