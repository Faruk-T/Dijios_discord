connect.dijios.com {
	encode gzip
	header /app/* X-Robots-Tag "noindex, nofollow, noarchive"
	header /api/* X-Robots-Tag "noindex, nofollow, noarchive"
	header /socket.io/* X-Robots-Tag "noindex, nofollow, noarchive"

	handle /socket.io/* {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /app/* {
		reverse_proxy web:80
	}

	handle {
		reverse_proxy landing:80
	}
}
