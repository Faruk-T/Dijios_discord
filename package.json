{
  "name": "dijios-connect",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --filter=./apps/* --filter=./packages/*",
    "dev": "turbo run dev --filter=./apps/* --filter=./packages/*",
    "lint": "turbo run lint --filter=./apps/* --filter=./packages/*",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && turbo run typecheck --filter=./apps/* --filter=./packages/*",
    "test": "vitest run && turbo run test --filter=./apps/* --filter=./packages/*",
    "check:lines": "node scripts/check-file-lines.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "turbo": "2.5.6",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
